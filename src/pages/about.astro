---
// src/pages/about.astro
import MainLayout from '../layouts/MainLayout.astro';
import { INITIAL_SITE_CONTENT } from '../data/site-content';
import { getBreadcrumbSchema } from '../utils/schema';

const aboutContent = INITIAL_SITE_CONTENT.about;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about' }
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
---

<MainLayout
  title="About Trailer Commerce | Engineered for the Journey"
  description="Discover the engineering philosophy, commercial inspection standards, and customer experience behind Trailer Commerce."
  canonical="/about"
  jsonLdSchema={[breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="about-hero-section">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-separator">/</li>
          <li class="breadcrumb-item is-current" aria-current="page">About</li>
        </ol>
      </nav>

      <div class="about-hero-content">
        <span class="eyebrow eyebrow-forest">OUR APPROACH & STANDARDS</span>
        <h1 class="about-hero-title" data-live-content="aboutHeroHeadline">
          {aboutContent.heroHeadline}
        </h1>
        <p class="about-hero-lead" data-live-content="aboutIntroParagraph">
          {aboutContent.introParagraph}
        </p>
      </div>
    </div>
  </section>

  <!-- Large Photography Strip -->
  <section class="about-photo-strip">
    <div class="container-wide">
      <div class="photo-banner">
        <img
          src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=2000&q=85"
          alt="Precision assembled trailers parked at transport yard"
          class="banner-img"
          fetchpriority="high"
        />
        <div class="photo-overlay-tag">
          <span class="mono-tag" style="color: #F5F3ED;">COMMERCIAL SPECIFICATION RIGIDITY</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Philosophy & Quality -->
  <section class="section about-philosophy-section">
    <div class="container">
      <div class="philosophy-grid">
        <div class="phil-col">
          <span class="eyebrow eyebrow-forest">CORE BENCHMARK</span>
          <h2 class="phil-heading">{aboutContent.philosophyTitle}</h2>
          <p class="phil-text">{aboutContent.philosophyText}</p>
        </div>

        <div class="phil-col">
          <span class="eyebrow eyebrow-forest">PRACTICAL USABILITY</span>
          <h2 class="phil-heading">{aboutContent.craftsmanshipTitle}</h2>
          <p class="phil-text">{aboutContent.craftsmanshipText}</p>
        </div>
      </div>

      <!-- Feature Metrics Grid -->
      <div class="metrics-grid">
        <div class="metric-card editorial-card">
          <span class="metric-number">100%</span>
          <span class="metric-label">Dexter Axles & EZ-Lube Hubs</span>
          <p class="metric-sub">Commercial-rated running gear with readily available domestic replacement parts.</p>
        </div>

        <div class="metric-card editorial-card">
          <span class="metric-number">16" OC</span>
          <span class="metric-label">Tubular Steel Stud Intervals</span>
          <p class="metric-sub">Rigid framing ensuring zero wall deflection during full highway payload transit.</p>
        </div>

        <div class="metric-card editorial-card">
          <span class="metric-number">24-PT</span>
          <span class="metric-label">Pre-Delivery Safety Check</span>
          <p class="metric-sub">Comprehensive torque inspection of lug nuts, brakes, hitch pins, and electrical grounds.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Three-Step Buying Experience -->
  <section class="section about-steps-section">
    <div class="container">
      <div class="section-head-centered">
        <span class="eyebrow eyebrow-forest">TRANSPARENT PROCESS</span>
        <h2 class="section-heading">A Thoughtful Three-Step Experience</h2>
        <p class="section-sub">
          We streamline discovery and technical matching so you drive away with complete towing confidence.
        </p>
      </div>

      <div class="steps-grid">
        {aboutContent.buyingSteps.map((step) => (
          <div class="step-card editorial-card">
            <span class="step-number">{step.step}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About CTA -->
  <section class="section-tight about-cta-strip">
    <div class="container text-center">
      <span class="eyebrow eyebrow-white">READY TO DISCUSS YOUR HAULING NEEDS</span>
      <h2 class="about-cta-title">Connect with a Trailer Specialist</h2>
      <p class="about-cta-desc">
        Have questions regarding towing vehicle tongue capacity or custom trailer outfitting?
      </p>
      <div class="about-cta-actions">
        <button id="about-open-enquiry-btn" class="btn btn-accent btn-lg">
          TALK TO OUR TEAM
        </button>
        <a href="/trailers" class="btn btn-outline-white btn-lg">
          BROWSE TRAILER MODELS
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-hero-section {
    background-color: var(--color-pale-sand);
    border-bottom: 1px solid var(--border-medium);
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
  }

  .about-hero-content {
    max-width: 820px;
    margin-top: 1rem;
  }

  .about-hero-title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    margin: 0.5rem 0 1rem 0;
  }

  .about-hero-lead {
    font-size: 1.15rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  /* Photo Strip */
  .about-photo-strip {
    padding: 2.5rem 0;
  }

  .photo-banner {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 480px;
    box-shadow: var(--shadow-card);
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-overlay-tag {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background-color: rgba(37, 39, 36, 0.85);
    backdrop-filter: blur(4px);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-xs);
  }

  /* Philosophy */
  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .philosophy-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .phil-heading {
    font-size: 1.75rem;
    margin: 0.4rem 0 0.85rem 0;
  }

  .phil-text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .metrics-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .metric-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .metric-number {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-forest-green);
  }

  .metric-label {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-deep-charcoal);
  }

  .metric-sub {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Steps Section */
  .about-steps-section {
    background-color: var(--color-pale-sand);
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step-card {
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-muted-copper);
  }

  .step-title {
    font-size: 1.25rem;
    margin: 0;
  }

  .step-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* About CTA */
  .about-cta-strip {
    background-color: var(--color-forest-green);
    color: var(--color-pure-white);
    padding: 5rem 0;
  }

  .about-cta-title {
    color: var(--color-pure-white);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    margin: 0.5rem 0 0.85rem 0;
  }

  .about-cta-desc {
    color: #D6D0C3;
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0 auto 2rem auto;
  }

  .about-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .text-center {
    text-align: center;
  }
</style>

<script>
  document.getElementById('about-open-enquiry-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-enquiry-modal', { detail: { product: '' } }));
  });
</script>
