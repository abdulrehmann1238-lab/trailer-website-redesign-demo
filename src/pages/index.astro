---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import BlogCard from '../components/BlogCard.astro';

import { INITIAL_PRODUCTS } from '../data/products';
import { CATEGORIES } from '../data/categories';
import { INITIAL_ARTICLES } from '../data/articles';
import { INITIAL_SITE_CONTENT } from '../data/site-content';

// Curate featured products specified in prompt
const featuredProductSlugs = [
  'enclosed-cargo-6x12',
  'utility-trailer-5x8',
  'heavy-duty-flatbed-7x16',
  'dual-axle-cargo-7x14'
];

const featuredProducts = INITIAL_PRODUCTS.filter((p) =>
  featuredProductSlugs.includes(p.slug)
);

const recentArticles = INITIAL_ARTICLES.slice(0, 3);
const siteContent = INITIAL_SITE_CONTENT;
---

<MainLayout
  title="TRAILER COMMERCE | Premium Commercial & Utility Trailers"
  description="Explore commercial enclosed, utility, flatbed, cargo, and horse trailers designed for dependable road travel and heavy payloads."
  canonical="/"
>
  <!-- Hero Section: Cinematic Full-Width Display -->
  <section class="hero-section" aria-label="Introduction hero">
    <div class="hero-media-wrapper">
      <img
        src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=2000&q=85"
        alt="Commercial trailer parked at scenic rugged roadside"
        class="hero-media-img"
        fetchpriority="high"
      />
      <div class="hero-overlay"></div>
    </div>

    <div class="container hero-container">
      <div class="hero-content">
        <span class="eyebrow eyebrow-white hero-eyebrow" data-live-content="heroEyebrow">
          {siteContent.homepage.heroEyebrow}
        </span>

        <h1 class="hero-title" data-live-content="heroHeadline">
          {siteContent.homepage.heroHeadline}
        </h1>

        <p class="hero-desc" data-live-content="heroDescription">
          {siteContent.homepage.heroDescription}
        </p>

        <div class="hero-cta-group">
          <a href="/trailers" class="btn btn-primary btn-lg hero-btn-primary">
            {siteContent.homepage.primaryCtaText}
          </a>
          <button id="hero-talk-btn" class="btn btn-outline-white btn-lg hero-btn-secondary">
            {siteContent.homepage.secondaryCtaText}
          </button>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <a href="#trust-strip" class="hero-scroll-indicator" aria-label="Scroll to content">
      <span class="scroll-label">EXPLORE</span>
      <div class="scroll-mouse">
        <div class="scroll-wheel"></div>
      </div>
    </a>
  </section>

  <!-- Section B: Trust Strip -->
  <section id="trust-strip" class="trust-section" aria-label="Key Commitments">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="trust-text">
            <h4 class="trust-title">Quality-led Selection</h4>
            <p class="trust-desc">Rigid tubular steel and extruded aluminum chassis vetted for heavy work.</p>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <div class="trust-text">
            <h4 class="trust-title">Practical Design</h4>
            <p class="trust-desc">Optimized ramp slopes, integrated stake pockets, and balanced axles.</p>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
              <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
            </svg>
          </div>
          <div class="trust-text">
            <h4 class="trust-title">Reliable Support</h4>
            <p class="trust-desc">Consultation from specialists who understand hauling physics and tongue weight.</p>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
            </svg>
          </div>
          <div class="trust-text">
            <h4 class="trust-title">Simple Product Discovery</h4>
            <p class="trust-desc">Transparent demo specs, axle ratings, and side-by-side comparison matrix.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section C: Category Section -->
  <section class="section categories-section">
    <div class="container">
      <div class="section-head-centered">
        <span class="eyebrow eyebrow-forest">PORTFOLIO OVERVIEW</span>
        <h2 class="section-heading">FIND THE TRAILER THAT FITS YOUR WORK.</h2>
        <p class="section-sub">
          Engineered for distinct hauling disciplines—from weather-sealed tool security to open-deck vehicle transport.
        </p>
      </div>

      <div class="category-grid">
        {CATEGORIES.map((cat) => (
          <CategoryCard category={cat} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section D: Featured Products -->
  <section class="section featured-products-section">
    <div class="container">
      <div class="section-head-split">
        <div>
          <span class="eyebrow eyebrow-forest">CORE INVENTORY</span>
          <h2 class="section-heading">A CLOSER LOOK AT OUR COLLECTION.</h2>
          <p class="section-sub">
            Carefully curated configurations ready for immediate deployment or custom outfitting.
          </p>
        </div>
        <a href="/trailers" class="btn btn-secondary">
          EXPLORE ALL TRAILERS &rarr;
        </a>
      </div>

      <div class="product-grid-four">
        {featuredProducts.map((product) => (
          <ProductCard product={product} featured={true} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section E: Editorial Split Section -->
  <section class="section editorial-split-section">
    <div class="container">
      <div class="editorial-split-grid">
        <div class="editorial-media-col">
          <div class="editorial-img-frame">
            <img
              src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=1200&q=80"
              alt="Heavy-duty cargo trailer in outdoor landscape"
              class="editorial-split-img"
              loading="lazy"
            />
            <div class="editorial-badge-pill">
              <span class="badge-dot"></span>
              <span>COMMERCIAL GRADE CHASSIS</span>
            </div>
          </div>
        </div>

        <div class="editorial-content-col">
          <span class="eyebrow eyebrow-forest" data-live-content="editorialEyebrow">
            {siteContent.homepage.editorialEyebrow}
          </span>
          <h2 class="editorial-main-title" data-live-content="editorialHeadline">
            {siteContent.homepage.editorialHeadline}
          </h2>
          <p class="editorial-subtitle">
            {siteContent.homepage.editorialSubtitle}
          </p>
          <p class="editorial-body" data-live-content="editorialParagraph">
            {siteContent.homepage.editorialParagraph}
          </p>

          <div class="editorial-checklist">
            <div class="check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26372F" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Dexter EZ-Lube & Torsion Axles on all commercial units</span>
            </div>
            <div class="check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26372F" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Pressure-treated or extruded aluminum flooring options</span>
            </div>
            <div class="check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26372F" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Completely sealed exterior LED wiring harnesses</span>
            </div>
          </div>

          <div class="editorial-cta-wrap">
            <a href="/trailers" class="btn btn-primary">
              {siteContent.homepage.editorialCtaText}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section F: Why Choose Us -->
  <section class="section why-choose-section">
    <div class="container">
      <div class="section-head-centered">
        <span class="eyebrow eyebrow-forest">THE TRAILER COMMERCE DIFFERENCE</span>
        <h2 class="section-heading">{siteContent.homepage.whyChooseHeadline}</h2>
        <p class="section-sub">
          Straightforward engineering standards and honest customer service eliminate the guesswork.
        </p>
      </div>

      <div class="why-choose-grid">
        {siteContent.homepage.whyChooseCards.map((card, idx) => (
          <div class="why-card editorial-card">
            <span class="why-card-index">0{idx + 1}</span>
            <h3 class="why-card-title">{card.title}</h3>
            <p class="why-card-desc">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section G: Journal Preview -->
  <section class="section journal-preview-section">
    <div class="container">
      <div class="section-head-split">
        <div>
          <span class="eyebrow eyebrow-forest">TECHNICAL KNOWLEDGE</span>
          <h2 class="section-heading">KNOWLEDGE FOR THE ROAD AHEAD.</h2>
          <p class="section-sub">
            Practical insights on weight distribution, maintenance schedules, and choosing the proper configuration.
          </p>
        </div>
        <a href="/blog" class="btn btn-secondary">
          READ ALL ARTICLES &rarr;
        </a>
      </div>

      <div class="journal-grid">
        {recentArticles.map((article) => (
          <BlogCard article={article} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section H: Final CTA -->
  <section class="final-cta-section" aria-label="Contact call to action">
    <div class="container final-cta-container">
      <div class="final-cta-content">
        <span class="eyebrow eyebrow-white">READY TO MOVE FORWARD</span>
        <h2 class="final-cta-title" data-live-content="finalCtaHeadline">
          {siteContent.homepage.finalCtaHeadline}
        </h2>
        <p class="final-cta-desc" data-live-content="finalCtaDescription">
          {siteContent.homepage.finalCtaDescription}
        </p>

        <div class="final-cta-buttons">
          <button id="final-cta-talk-btn" class="btn btn-accent btn-lg">
            CONTACT OUR TEAM
          </button>
          <a href="/trailers" class="btn btn-outline-white btn-lg">
            BROWSE TRAILERS
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4rem, 8vw, 8rem) 0;
    overflow: hidden;
    background-color: var(--color-deep-charcoal);
    color: var(--color-pure-white);
  }

  .hero-media-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    animation: gentleHeroZoom 20s ease-in-out infinite alternate;
  }

  @keyframes gentleHeroZoom {
    0% { transform: scale(1.01); }
    100% { transform: scale(1.06); }
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(28, 43, 36, 0.75) 0%,
      rgba(37, 39, 36, 0.85) 60%,
      rgba(37, 39, 36, 0.95) 100%
    );
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-eyebrow {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    color: var(--color-pure-white);
    font-size: clamp(2.5rem, 6vw + 0.5rem, 4.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .hero-desc {
    color: #E2DFD8;
    font-size: clamp(1.1rem, 1.3vw + 0.8rem, 1.35rem);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 680px;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* Scroll Indicator */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-soft-stone);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--transition-fast);
  }

  .hero-scroll-indicator:hover {
    opacity: 1;
  }

  .scroll-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
  }

  .scroll-mouse {
    width: 20px;
    height: 32px;
    border: 2px solid var(--color-soft-stone);
    border-radius: 12px;
    position: relative;
  }

  .scroll-wheel {
    width: 4px;
    height: 6px;
    background-color: var(--color-muted-copper);
    border-radius: 2px;
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    animation: scrollWheelAnim 1.8s ease-in-out infinite;
  }

  @keyframes scrollWheelAnim {
    0% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, 12px); }
  }

  /* Trust Strip */
  .trust-section {
    background-color: var(--color-pale-sand);
    border-bottom: 1px solid var(--border-medium);
    padding: 2.25rem 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .trust-icon-wrap {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-forest-green);
    flex-shrink: 0;
  }

  .trust-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--color-deep-charcoal);
  }

  .trust-desc {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  /* Section Headers */
  .section-head-centered {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem) auto;
  }

  .section-head-split {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    flex-wrap: wrap;
  }

  .section-heading {
    margin-top: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .section-sub {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Categories Grid */
  .category-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    /* Make first two cards span nicely or 5 cards balance */
    .category-grid > :nth-child(1) {
      grid-column: span 1;
    }
  }

  /* Products 4-Grid */
  .product-grid-four {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .product-grid-four {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .product-grid-four {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Editorial Split Section */
  .editorial-split-section {
    background-color: var(--color-pale-sand);
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium);
  }

  .editorial-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .editorial-split-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .editorial-img-frame {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-elevated);
  }

  .editorial-split-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-badge-pill {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    background-color: rgba(37, 39, 36, 0.9);
    backdrop-filter: blur(4px);
    color: var(--color-warm-ivory);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-muted-copper);
    border-radius: 50%;
  }

  .editorial-content-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .editorial-main-title {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin: 0.5rem 0 1rem 0;
  }

  .editorial-subtitle {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-forest-green);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .editorial-body {
    font-size: 0.98rem;
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .editorial-checklist {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .check-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--color-deep-charcoal);
  }

  /* Why Choose Grid */
  .why-choose-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .why-choose-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .why-choose-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .why-card {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background-color: var(--color-pure-white);
  }

  .why-card-index {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-muted-copper);
  }

  .why-card-title {
    font-size: 1.15rem;
    margin: 0;
  }

  .why-card-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Journal Grid */
  .journal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .journal-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Final CTA */
  .final-cta-section {
    background-color: var(--color-forest-green);
    color: var(--color-pure-white);
    padding: clamp(4rem, 8vw, 6.5rem) 0;
  }

  .final-cta-container {
    text-align: center;
  }

  .final-cta-content {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final-cta-title {
    color: var(--color-pure-white);
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 0.75rem 0 1rem 0;
  }

  .final-cta-desc {
    color: #D6D0C3;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .final-cta-buttons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>

<script>
  document.getElementById('hero-talk-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-enquiry-modal', { detail: { product: '' } }));
  });

  document.getElementById('final-cta-talk-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-enquiry-modal', { detail: { product: '' } }));
  });
</script>
