---
// src/pages/admin/login.astro
import '../../styles/variables.css';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Payload CMS Administration Login | TRAILER COMMERCE</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="login-body">
    <div class="login-wrapper">
      <div class="login-card editorial-card">
        <!-- Brand Header -->
        <div class="login-brand-header">
          <div class="login-emblem">
            <svg viewBox="0 0 48 48" fill="none" class="emblem-svg">
              <rect width="48" height="48" rx="8" fill="#26372F"/>
              <path d="M12 28L18 16H36L30 28H12Z" fill="#F5F3ED"/>
              <circle cx="19" cy="33" r="3.5" fill="#A66E4D"/>
              <circle cx="29" cy="33" r="3.5" fill="#A66E4D"/>
            </svg>
          </div>
          <span class="login-brand-title">TRAILER COMMERCE</span>
          <span class="login-brand-sub">PAYLOAD CMS ARCHITECTURE DEMO</span>
        </div>

        <div class="login-title-group">
          <h1 class="login-main-heading">WELCOME BACK.</h1>
          <p class="login-intro">
            Sign in to manage commercial inventory, edit pricing, replace imagery, and publish journal articles.
          </p>
        </div>

        <!-- Demonstration Notice Banner -->
        <div class="demo-credentials-banner">
          <div class="banner-badge">DEMONSTRATION ACCESS</div>
          <p class="banner-note">
            This administration panel demonstrates real-time frontend content synchronization. Use the pre-filled demo credentials below:
          </p>
          <div class="credentials-box">
            <div><span class="cred-label">Email:</span> <code>admin@trailercommerce.demo</code></div>
            <div><span class="cred-label">Password:</span> <code>TrailerDemo123!</code></div>
          </div>
          <button id="autofill-btn" type="button" class="btn-autofill">
            AUTO-FILL DEMO CREDENTIALS &darr;
          </button>
        </div>

        <!-- Login Form -->
        <form id="admin-login-form" class="admin-login-form" novalidate>
          <div class="form-group">
            <label for="admin-email" class="form-label">Email Address</label>
            <input
              type="email"
              id="admin-email"
              class="form-input"
              value="admin@trailercommerce.demo"
              required
              autocomplete="username"
            />
          </div>

          <div class="form-group">
            <div class="label-row">
              <label for="admin-password" class="form-label">Password</label>
              <span class="demo-pw-hint">Preset: TrailerDemo123!</span>
            </div>
            <input
              type="password"
              id="admin-password"
              class="form-input"
              value="TrailerDemo123!"
              required
              autocomplete="current-password"
            />
          </div>

          <div class="form-options-row">
            <label class="remember-me-label">
              <input type="checkbox" id="admin-remember" checked />
              <span>Remember demo session</span>
            </label>
          </div>

          <div id="login-error-msg" class="login-error-msg" style="display: none;"></div>

          <button type="submit" id="login-submit-btn" class="btn btn-primary btn-lg btn-block">
            SIGN IN TO DASHBOARD &rarr;
          </button>
        </form>

        <div class="login-card-footer">
          <a href="/" class="back-to-store-link">
            &larr; Return to Storefront
          </a>
          <a href="/handover" class="handover-link">
            Handover Architecture &rarr;
          </a>
        </div>
      </div>
    </div>

    <style>
      .login-body {
        background-color: #F7F6F2;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
      }

      .login-wrapper {
        width: 100%;
        max-width: 490px;
      }

      .login-card {
        padding: clamp(2rem, 5vw, 2.75rem);
        background-color: var(--color-pure-white);
        box-shadow: var(--shadow-card);
      }

      .login-brand-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 1.75rem;
      }

      .login-emblem {
        width: 44px;
        height: 44px;
        margin-bottom: 0.75rem;
      }

      .emblem-svg {
        width: 100%;
        height: 100%;
      }

      .login-brand-title {
        font-family: var(--font-heading);
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: var(--color-deep-charcoal);
      }

      .login-brand-sub {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        color: var(--color-forest-green);
        text-transform: uppercase;
      }

      .login-title-group {
        text-align: center;
        margin-bottom: 1.75rem;
      }

      .login-main-heading {
        font-size: 1.75rem;
        margin: 0 0 0.4rem 0;
      }

      .login-intro {
        font-size: 0.88rem;
        color: var(--text-secondary);
        line-height: 1.5;
        margin: 0;
      }

      .demo-credentials-banner {
        background-color: var(--color-pale-sand);
        border: 1px solid var(--border-medium);
        border-radius: var(--radius-sm);
        padding: 1rem 1.15rem;
        margin-bottom: 1.75rem;
      }

      .banner-badge {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--color-muted-copper);
        margin-bottom: 0.35rem;
      }

      .banner-note {
        font-size: 0.78rem;
        color: var(--text-secondary);
        margin-bottom: 0.65rem;
        line-height: 1.4;
      }

      .credentials-box {
        font-size: 0.78rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 0.65rem;
      }

      .cred-label {
        font-family: var(--font-mono);
        color: var(--text-muted);
      }

      .credentials-box code {
        font-family: var(--font-mono);
        font-weight: 600;
        color: var(--color-forest-green);
        background-color: var(--color-pure-white);
        padding: 0.1rem 0.35rem;
        border-radius: 2px;
      }

      .btn-autofill {
        background: transparent;
        border: 1px dashed var(--color-forest-green);
        border-radius: var(--radius-xs);
        padding: 0.35rem 0.65rem;
        font-family: var(--font-heading);
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--color-forest-green);
        cursor: pointer;
        width: 100%;
        transition: all var(--transition-fast);
      }

      .btn-autofill:hover {
        background-color: var(--color-forest-green);
        color: var(--color-pure-white);
      }

      .label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .demo-pw-hint {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-muted);
      }

      .form-options-row {
        margin-bottom: 1.25rem;
      }

      .remember-me-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: var(--text-secondary);
        cursor: pointer;
      }

      .login-error-msg {
        background-color: #FDEDED;
        border: 1px solid #E0B4B4;
        color: #9F3A38;
        padding: 0.65rem 0.85rem;
        border-radius: var(--radius-xs);
        font-size: 0.82rem;
        margin-bottom: 1.25rem;
      }

      .login-card-footer {
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.82rem;
      }

      .back-to-store-link {
        color: var(--text-secondary);
      }
      .back-to-store-link:hover {
        color: var(--color-deep-charcoal);
      }

      .handover-link {
        color: var(--color-forest-green);
        font-weight: 600;
      }
    </style>

    <script>
      import { loadDemoState, saveDemoState } from '../../utils/demo-state';

      const form = document.getElementById('admin-login-form') as HTMLFormElement;
      const emailInput = document.getElementById('admin-email') as HTMLInputElement;
      const passwordInput = document.getElementById('admin-password') as HTMLInputElement;
      const autofillBtn = document.getElementById('autofill-btn');
      const errorMsg = document.getElementById('login-error-msg');

      autofillBtn?.addEventListener('click', () => {
        if (emailInput) emailInput.value = 'admin@trailercommerce.demo';
        if (passwordInput) passwordInput.value = 'TrailerDemo123!';
      });

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = emailInput?.value.trim() || '';
        const password = passwordInput?.value || '';

        if (!email || !password) {
          if (errorMsg) {
            errorMsg.style.display = 'block';
            errorMsg.textContent = 'Please provide both email and password.';
          }
          return;
        }

        // Accept demo credentials or any reasonable input for convenience
        const state = loadDemoState();
        state.auth = {
          isAuthenticated: true,
          user: {
            email: email,
            name: 'Serkan (Administrator)',
            role: 'owner'
          }
        };
        saveDemoState(state);

        // Redirect
        const urlParams = new URLSearchParams(window.location.search);
        const redirect = urlParams.get('redirect') || '/admin';
        window.location.href = redirect;
      });
    </script>
  </body>
</html>
