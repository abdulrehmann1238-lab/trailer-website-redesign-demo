---
// src/pages/trailers/[category].astro
import MainLayout from '../../layouts/MainLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { CATEGORIES, type Category } from '../../data/categories';
import { INITIAL_PRODUCTS } from '../../data/products';
import { getBreadcrumbSchema } from '../../utils/schema';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;

// Filter matching products
const categoryProducts = INITIAL_PRODUCTS.filter(
  (p) => p.category === category.slug
);

// Other categories for related section
const otherCategories = CATEGORIES.filter((c) => c.slug !== category.slug).slice(0, 3);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Trailers', url: '/trailers' },
  { name: category.name, url: `/trailers/${category.slug}` }
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
---

<MainLayout
  title={category.seoTitle}
  description={category.seoDescription}
  canonical={`/trailers/${category.slug}`}
  image={category.heroImage}
  jsonLdSchema={[breadcrumbSchema]}
>
  <!-- Category Cinematic Hero -->
  <section class="category-hero-section">
    <div class="category-hero-bg">
      <img
        src={category.heroImage}
        alt={category.name}
        class="category-hero-img"
        fetchpriority="high"
      />
      <div class="category-hero-overlay"></div>
    </div>

    <div class="container category-hero-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list breadcrumb-light">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-separator">/</li>
          <li class="breadcrumb-item"><a href="/trailers">Trailers</a></li>
          <li class="breadcrumb-separator">/</li>
          <li class="breadcrumb-item is-current" aria-current="page">{category.name}</li>
        </ol>
      </nav>

      <div class="hero-text-block">
        <span class="eyebrow eyebrow-white">{category.productCount} CONFIGURATIONS AVAILABLE</span>
        <h1 class="category-hero-title">{category.name}</h1>
        <p class="category-hero-lead">{category.longDescription}</p>

        <div class="hero-actions-row">
          <a href="#models-grid" class="btn btn-primary">
            VIEW AVAILABLE MODELS ({categoryProducts.length})
          </a>
          <button id="category-custom-quote-btn" class="btn btn-outline-white">
            CUSTOM BUILD ENQUIRY
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Engineering Features Strip -->
  <section class="cat-features-section" aria-label="Key Engineering Specifications">
    <div class="container">
      <div class="cat-features-grid">
        {category.features.map((feature, idx) => (
          <div class="cat-feature-item">
            <span class="feature-idx">0{idx + 1}</span>
            <p class="feature-desc">{feature}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Category Products Grid -->
  <section id="models-grid" class="section category-models-section">
    <div class="container">
      <div class="section-head-split">
        <div>
          <span class="eyebrow eyebrow-forest">CURRENT INVENTORY & ORDERS</span>
          <h2 class="section-heading">{category.name} Lineup</h2>
          <p class="section-sub">
            Review detailed dimensions, axle setups, and load capacities.
          </p>
        </div>
        <a href="/trailers" class="btn btn-secondary btn-sm">
          VIEW ALL OTHER CATEGORIES &rarr;
        </a>
      </div>

      <div class="cat-products-grid">
        {categoryProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- Informational In-Depth Guide & FAQs -->
  <section class="section cat-guide-section">
    <div class="container">
      <div class="cat-guide-grid">
        <!-- Informational Guide Column -->
        <div class="guide-info-col">
          <span class="eyebrow eyebrow-forest">PURCHASING ADVICE</span>
          <h2 class="guide-title">Selecting the Optimal {category.name}</h2>
          <p class="guide-p">
            When choosing between different dimensional variants in the {category.name} class, consider both current payload demands and anticipated growth. Matching hitch ratings and brake controller requirements to your tow vehicle ensures legal highway compliance and prevents excessive transmission heat.
          </p>
          <div class="guide-callout-box">
            <h4 class="callout-heading">Specialist Recommendation</h4>
            <p class="callout-body">
              Always leave a minimum 15% margin between your typical loaded cargo weight and the official trailer payload rating to account for accessories, toolboxes, and fluid tanks.
            </p>
          </div>
        </div>

        <!-- FAQs Accordion Column -->
        <div class="guide-faq-col">
          <span class="eyebrow eyebrow-forest">FREQUENTLY ASKED QUESTIONS</span>
          <h2 class="guide-title">{category.name} FAQ</h2>
          
          <div class="faq-list">
            {category.faqs.map((faq, i) => (
              <details class="faq-item" open={i === 0}>
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Categories -->
  <section class="section related-cat-section">
    <div class="container">
      <div class="section-head-centered">
        <span class="eyebrow eyebrow-forest">EXPLORE ALTERNATIVES</span>
        <h2 class="section-heading">Related Trailer Categories</h2>
        <p class="section-sub">
          Compare different trailer formats to find the ideal match for your hauling needs.
        </p>
      </div>

      <div class="related-cat-grid">
        {otherCategories.map((c) => (
          <CategoryCard category={c} />
        ))}
      </div>
    </div>
  </section>

  <!-- Category Bottom CTA -->
  <section class="cat-bottom-cta">
    <div class="container text-center">
      <h2 class="cta-title">Need a Custom {category.name} Setup?</h2>
      <p class="cta-desc">
        We configure custom wall heights, E-track installations, torsion axles, and exterior colors to match your commercial vehicle fleet.
      </p>
      <button id="cat-cta-enquire-btn" class="btn btn-primary btn-lg">
        REQUEST A CUSTOM SPECIFICATION
      </button>
    </div>
  </section>
</MainLayout>

<style>
  /* Category Hero */
  .category-hero-section {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    padding: clamp(4rem, 6vw, 6.5rem) 0;
    overflow: hidden;
    background-color: var(--color-deep-charcoal);
    color: var(--color-pure-white);
  }

  .category-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .category-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(28, 43, 36, 0.8) 0%,
      rgba(37, 39, 36, 0.9) 100%
    );
  }

  .category-hero-container {
    position: relative;
    z-index: 2;
  }

  .breadcrumb-light a {
    color: #C7C9C4 !important;
  }
  .breadcrumb-light .is-current {
    color: var(--color-warm-ivory) !important;
  }
  .breadcrumb-light .breadcrumb-separator {
    color: rgba(255, 255, 255, 0.3) !important;
  }

  .hero-text-block {
    max-width: 760px;
    margin-top: 1.5rem;
  }

  .category-hero-title {
    color: var(--color-pure-white);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    margin: 0.5rem 0 1rem 0;
  }

  .category-hero-lead {
    color: #E2DFD8;
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-actions-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* Features Strip */
  .cat-features-section {
    background-color: var(--color-pale-sand);
    border-bottom: 1px solid var(--border-medium);
    padding: 2.5rem 0;
  }

  .cat-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .cat-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cat-features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cat-feature-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
  }

  .feature-idx {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-muted-copper);
  }

  .feature-desc {
    font-size: 0.88rem;
    color: var(--color-deep-charcoal);
    font-weight: 500;
    line-height: 1.45;
    margin: 0;
  }

  /* Models Grid */
  .cat-products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .cat-products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cat-products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Guide & FAQs */
  .cat-guide-section {
    background-color: var(--color-pale-sand);
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium);
  }

  .cat-guide-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 992px) {
    .cat-guide-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .guide-title {
    font-size: 1.85rem;
    margin: 0.35rem 0 1rem 0;
  }

  .guide-p {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .guide-callout-box {
    padding: 1.5rem;
    background-color: var(--color-pure-white);
    border-left: 4px solid var(--color-forest-green);
    border-radius: var(--radius-sm);
  }

  .callout-heading {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }

  .callout-body {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  /* FAQ Accordion */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .faq-question {
    padding: 1.1rem 1.25rem;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-deep-charcoal);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: var(--color-forest-green);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem 1.25rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Related Categories */
  .related-cat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .related-cat-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Bottom CTA */
  .cat-bottom-cta {
    background-color: var(--color-pure-white);
    padding: 4.5rem 0;
    border-top: 1px solid var(--border-light);
  }

  .cta-title {
    font-size: 2.2rem;
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    max-width: 620px;
    margin: 0 auto 2rem auto;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .text-center {
    text-align: center;
  }
</style>

<script>
  // Wire quote buttons
  document.getElementById('category-custom-quote-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-enquiry-modal', { detail: { product: '' } }));
  });

  document.getElementById('cat-cta-enquire-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-enquiry-modal', { detail: { product: '' } }));
  });
</script>
