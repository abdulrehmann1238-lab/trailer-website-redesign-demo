---
// src/pages/trailers/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { INITIAL_PRODUCTS } from '../../data/products';
import { CATEGORIES } from '../../data/categories';
import { getBreadcrumbSchema } from '../../utils/schema';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Trailers', url: '/trailers' }
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
---

<MainLayout
  title="Trailer Catalogue | Commercial & Utility Models | Trailer Commerce"
  description="Explore our full collection of enclosed cargo, utility, flatbed, cargo, and horse trailers. Compare specifications, axle ratings, and transparent demo prices."
  canonical="/trailers"
  jsonLdSchema={[breadcrumbSchema]}
>
  <!-- Catalogue Header -->
  <section class="catalogue-header-section">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-separator">/</li>
          <li class="breadcrumb-item is-current" aria-current="page">Trailers</li>
        </ol>
      </nav>

      <div class="catalogue-hero-content">
        <span class="eyebrow eyebrow-forest">COMMERCIAL & UTILITY CATALOGUE</span>
        <h1 class="catalogue-title">OUR TRAILER COLLECTION</h1>
        <p class="catalogue-lead">
          Explore precision-engineered trailers designed for dependable towing, high payload safety, and lasting commercial service. Filter by axle configuration, category, or dimensions.
        </p>
      </div>
    </div>
  </section>

  <!-- Catalogue Workspace: Filters & Product Grid -->
  <section class="catalogue-body-section">
    <div class="container">
      <!-- Mobile Filter Toggle & Quick Bar -->
      <div class="catalogue-controls-bar">
        <div class="controls-left">
          <button id="open-filter-drawer-btn" class="mobile-filter-btn" aria-label="Open filter menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <span>FILTERS</span>
            <span id="active-filter-badge" class="active-badge" style="display: none;">0</span>
          </button>

          <span class="catalogue-count-indicator">
            Showing <strong id="displayed-products-count">{INITIAL_PRODUCTS.length}</strong> trailers
          </span>
        </div>

        <div class="controls-right">
          <!-- Live Search Bar -->
          <div class="catalogue-search-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="filter-search-input"
              class="catalogue-search-input"
              placeholder="Filter by name, size, axle..."
              aria-label="Filter catalogue live"
            />
          </div>

          <!-- Sorting Select -->
          <div class="sort-select-wrap">
            <label for="catalogue-sort" class="sort-label">SORT:</label>
            <select id="catalogue-sort" class="catalogue-sort-select">
              <option value="featured">Featured First</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="name-asc">Name: A to Z</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Main Layout: Sidebar + Grid -->
      <div class="catalogue-layout">
        <!-- Desktop Sidebar / Mobile Drawer -->
        <aside id="catalogue-sidebar" class="catalogue-sidebar" aria-label="Product Filters">
          <div class="sidebar-header-mobile">
            <span class="drawer-title">FILTER TRAILERS</span>
            <button id="close-filter-drawer-btn" class="drawer-close-btn" aria-label="Close filters">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <div class="filter-group">
            <span class="filter-title">CATEGORY</span>
            <div class="filter-options">
              <label class="filter-radio-label">
                <input type="radio" name="filter-category" value="all" checked />
                <span>All Categories</span>
              </label>
              {CATEGORIES.map((cat) => (
                <label class="filter-radio-label">
                  <input type="radio" name="filter-category" value={cat.slug} />
                  <span>{cat.name}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="filter-group">
            <span class="filter-title">PRICE RANGE</span>
            <div class="filter-options">
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-price" value="under-3000" />
                <span>Under $3,000</span>
              </label>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-price" value="3000-7000" />
                <span>$3,000 – $7,000</span>
              </label>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-price" value="over-7000" />
                <span>$7,000+</span>
              </label>
            </div>
          </div>

          <div class="filter-group">
            <span class="filter-title">AXLE SETUP</span>
            <div class="filter-options">
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-axle" value="single" />
                <span>Single Axle (Lightweight)</span>
              </label>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-axle" value="tandem" />
                <span>Tandem / Dual Axle (Heavy Duty)</span>
              </label>
            </div>
          </div>

          <div class="filter-group">
            <span class="filter-title">AVAILABILITY</span>
            <div class="filter-options">
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-avail" value="In Stock" />
                <span>In Stock Now</span>
              </label>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-avail" value="Built to Order" />
                <span>Built to Order</span>
              </label>
            </div>
          </div>

          <div class="sidebar-actions">
            <button id="reset-filters-btn" class="btn btn-secondary btn-sm btn-block">
              RESET ALL FILTERS
            </button>
          </div>
        </aside>

        <!-- Product Grid Area -->
        <div class="catalogue-grid-container">
          <!-- Active Filter Tags Strip -->
          <div id="active-filters-strip" class="active-filters-strip" style="display: none;">
            <span class="active-filters-label">Active:</span>
            <div id="active-tags-list" class="active-tags-list"></div>
            <button id="clear-tags-action" class="clear-all-link">Clear All</button>
          </div>

          <!-- Product Cards Grid -->
          <div id="catalogue-products-grid" class="catalogue-products-grid">
            {INITIAL_PRODUCTS.map((prod) => (
              <ProductCard product={prod} />
            ))}
          </div>

          <!-- No Results Fallback -->
          <div id="catalogue-no-results" class="no-results-box" style="display: none;">
            <div class="no-results-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <h3 class="no-results-title">No trailers match your criteria</h3>
            <p class="no-results-sub">Try expanding your price range or clearing active filters to see all available inventory.</p>
            <button id="no-results-clear-btn" class="btn btn-primary btn-sm">
              CLEAR ALL FILTERS
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div id="filter-drawer-backdrop" class="filter-backdrop"></div>
</MainLayout>

<style>
  /* Header */
  .catalogue-header-section {
    background-color: var(--color-pale-sand);
    border-bottom: 1px solid var(--border-medium);
    padding: clamp(2rem, 4vw, 3.5rem) 0;
  }

  .breadcrumb-nav {
    margin-bottom: 1.25rem;
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .breadcrumb-item a {
    color: var(--text-secondary);
  }

  .breadcrumb-item.is-current {
    color: var(--color-forest-green);
    font-weight: 600;
  }

  .breadcrumb-separator {
    color: var(--border-dark);
  }

  .catalogue-title {
    margin: 0.4rem 0 0.85rem 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .catalogue-lead {
    max-width: 720px;
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Body */
  .catalogue-body-section {
    padding: clamp(2rem, 4vw, 4rem) 0 6rem 0;
  }

  /* Controls Bar */
  .catalogue-controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-light);
    flex-wrap: wrap;
  }

  .controls-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .catalogue-count-indicator {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .mobile-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.95rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-deep-charcoal);
    cursor: pointer;
  }

  @media (min-width: 992px) {
    .mobile-filter-btn {
      display: none;
    }
  }

  .active-badge {
    background-color: var(--color-forest-green);
    color: var(--color-pure-white);
    border-radius: 50%;
    width: 18px;
    height: 18px;
    font-size: 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .controls-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .catalogue-search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.75rem;
    min-width: 240px;
  }

  .catalogue-search-input {
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--color-deep-charcoal);
    outline: none;
    width: 100%;
  }

  .sort-select-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sort-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .catalogue-sort-select {
    padding: 0.5rem 0.75rem;
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-deep-charcoal);
    cursor: pointer;
  }

  /* Main Layout */
  .catalogue-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: flex-start;
  }

  @media (min-width: 992px) {
    .catalogue-layout {
      grid-template-columns: 260px 1fr;
    }
  }

  /* Sidebar */
  .catalogue-sidebar {
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (max-width: 991px) {
    .catalogue-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      width: min(320px, 85vw);
      height: 100vh;
      overflow-y: auto;
      z-index: 2200;
      border-radius: 0;
      transform: translateX(-100%);
      transition: transform var(--transition-base);
      box-shadow: 8px 0 24px rgba(37, 39, 36, 0.15);
    }

    .catalogue-sidebar.is-open {
      transform: translateX(0);
    }
  }

  .sidebar-header-mobile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-light);
  }

  @media (min-width: 992px) {
    .sidebar-header-mobile {
      display: none;
    }
  }

  .drawer-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
  }

  .drawer-close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-deep-charcoal);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .filter-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .filter-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-radio-label, .filter-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--color-deep-charcoal);
    cursor: pointer;
  }

  .filter-radio-label input, .filter-checkbox-label input {
    accent-color: var(--color-forest-green);
    cursor: pointer;
  }

  .sidebar-actions {
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  /* Grid Area */
  .catalogue-grid-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .active-filters-strip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding: 0.6rem 0.85rem;
    background-color: var(--color-pale-sand);
    border-radius: var(--radius-sm);
  }

  .active-filters-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .active-tags-list {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  :global(.filter-pill-tag) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xs);
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .clear-all-link {
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #A82424;
    cursor: pointer;
    text-decoration: underline;
    margin-left: auto;
  }

  /* Products Responsive Grid */
  .catalogue-products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .catalogue-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }

  @media (min-width: 1200px) {
    .catalogue-products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 540px) {
    .catalogue-products-grid {
      grid-template-columns: 1fr;
    }
  }

  /* No Results */
  .no-results-box {
    text-align: center;
    padding: 4rem 1.5rem;
    background-color: var(--color-pure-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .no-results-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--color-pale-sand);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .no-results-title {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .no-results-sub {
    font-size: 0.92rem;
    color: var(--text-secondary);
    max-width: 440px;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .filter-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(37, 39, 36, 0.45);
    backdrop-filter: blur(4px);
    z-index: 2100;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-base), visibility var(--transition-base);
  }

  .filter-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  import { loadDemoState, type Product } from '../../utils/demo-state';

  // Elements
  const searchInput = document.getElementById('filter-search-input') as HTMLInputElement;
  const sortSelect = document.getElementById('catalogue-sort') as HTMLSelectElement;
  const countIndicator = document.getElementById('displayed-products-count');
  const productsGrid = document.getElementById('catalogue-products-grid');
  const noResults = document.getElementById('catalogue-no-results');
  const resetBtn = document.getElementById('reset-filters-btn');
  const noResultsResetBtn = document.getElementById('no-results-clear-btn');
  const activeStrip = document.getElementById('active-filters-strip');
  const activeTagsList = document.getElementById('active-tags-list');
  const clearTagsAction = document.getElementById('clear-tags-action');

  // Mobile Drawer Elements
  const openDrawerBtn = document.getElementById('open-filter-drawer-btn');
  const closeDrawerBtn = document.getElementById('close-filter-drawer-btn');
  const sidebar = document.getElementById('catalogue-sidebar');
  const backdrop = document.getElementById('filter-drawer-backdrop');
  const activeBadge = document.getElementById('active-filter-badge');

  function openDrawer() {
    sidebar?.classList.add('is-open');
    backdrop?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    sidebar?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  openDrawerBtn?.addEventListener('click', openDrawer);
  closeDrawerBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  // Check URL query parameters on load (e.g. ?category=enclosed-trailers)
  const urlParams = new URLSearchParams(window.location.search);
  const initialCatParam = urlParams.get('category');
  if (initialCatParam) {
    const radio = document.querySelector(`input[name="filter-category"][value="${initialCatParam}"]`) as HTMLInputElement;
    if (radio) radio.checked = true;
  }

  // Filter application
  function applyFilters() {
    const state = loadDemoState();
    let items = [...state.products];

    // Search query
    const q = searchInput?.value.trim().toLowerCase() || '';
    if (q) {
      items = items.filter((p) =>
        p.name.toLowerCase().includes(q) ||
        p.shortDescription.toLowerCase().includes(q) ||
        p.categoryName.toLowerCase().includes(q) ||
        p.specifications.dimensions.toLowerCase().includes(q) ||
        p.specifications.axles.toLowerCase().includes(q)
      );
    }

    // Category
    const selectedCatRadio = document.querySelector('input[name="filter-category"]:checked') as HTMLInputElement;
    const catVal = selectedCatRadio?.value;
    if (catVal && catVal !== 'all') {
      items = items.filter((p) => p.category === catVal);
    }

    // Price
    const checkedPrices = Array.from(document.querySelectorAll('input[name="filter-price"]:checked')).map(
      (el) => (el as HTMLInputElement).value
    );
    if (checkedPrices.length > 0) {
      items = items.filter((p) => {
        const effectivePrice = p.salePrice || p.price;
        return checkedPrices.some((range) => {
          if (range === 'under-3000') return effectivePrice < 3000;
          if (range === '3000-7000') return effectivePrice >= 3000 && effectivePrice <= 7000;
          if (range === 'over-7000') return effectivePrice > 7000;
          return true;
        });
      });
    }

    // Axles
    const checkedAxles = Array.from(document.querySelectorAll('input[name="filter-axle"]:checked')).map(
      (el) => (el as HTMLInputElement).value
    );
    if (checkedAxles.length > 0) {
      items = items.filter((p) => {
        const ax = p.specifications.axles.toLowerCase();
        return checkedAxles.some((term) => ax.includes(term));
      });
    }

    // Availability
    const checkedAvail = Array.from(document.querySelectorAll('input[name="filter-avail"]:checked')).map(
      (el) => (el as HTMLInputElement).value
    );
    if (checkedAvail.length > 0) {
      items = items.filter((p) => checkedAvail.includes(p.specifications.availability));
    }

    // Sorting
    const sortVal = sortSelect?.value || 'featured';
    if (sortVal === 'price-asc') {
      items.sort((a, b) => (a.salePrice || a.price) - (b.salePrice || b.price));
    } else if (sortVal === 'price-desc') {
      items.sort((a, b) => (b.salePrice || b.price) - (a.salePrice || a.price));
    } else if (sortVal === 'name-asc') {
      items.sort((a, b) => a.name.localeCompare(b.name));
    }

    // Update count indicator
    if (countIndicator) countIndicator.textContent = String(items.length);

    // Update active badges & tags
    let activeFilterCount = (catVal && catVal !== 'all' ? 1 : 0) + checkedPrices.length + checkedAxles.length + checkedAvail.length + (q ? 1 : 0);
    if (activeBadge) {
      if (activeFilterCount > 0) {
        activeBadge.style.display = 'inline-flex';
        activeBadge.textContent = String(activeFilterCount);
      } else {
        activeBadge.style.display = 'none';
      }
    }

    if (activeStrip && activeTagsList) {
      if (activeFilterCount > 0) {
        activeStrip.style.display = 'flex';
        const tags: string[] = [];
        if (catVal && catVal !== 'all') tags.push(`Category: ${catVal}`);
        if (checkedPrices.length > 0) tags.push(`${checkedPrices.length} Price Filters`);
        if (checkedAxles.length > 0) tags.push(`${checkedAxles.length} Axle Filters`);
        if (checkedAvail.length > 0) tags.push(`${checkedAvail.length} Availability Filters`);
        if (q) tags.push(`Query: "${q}"`);
        activeTagsList.innerHTML = tags.map(t => `<span class="filter-pill-tag">${t}</span>`).join('');
      } else {
        activeStrip.style.display = 'none';
        activeTagsList.innerHTML = '';
      }
    }

    // Render results
    if (items.length === 0) {
      if (productsGrid) productsGrid.style.display = 'none';
      if (noResults) noResults.style.display = 'flex';
    } else {
      if (noResults) noResults.style.display = 'none';
      if (productsGrid) {
        productsGrid.style.display = 'grid';
        renderProductsDOM(items);
      }
    }
  }

  function renderProductsDOM(products: Product[]) {
    if (!productsGrid) return;
    productsGrid.innerHTML = products.map((p) => `
      <article
        class="product-card editorial-card"
        data-product-id="${p.id}"
        data-slug="${p.slug}"
        data-category="${p.category}"
      >
        <div class="card-media-wrap img-container">
          <a href="/product/${p.slug}" class="card-img-link" aria-label="View ${p.name}">
            <img
              src="${p.mainImage}"
              alt="${p.name}"
              loading="lazy"
              class="card-img product-live-img"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=600&q=80';"
            />
          </a>
          <div class="card-badges">
            <span class="badge badge-category product-live-category">${p.categoryName}</span>
            <span class="badge ${p.specifications.availability === 'In Stock' ? 'badge-stock' : 'badge-order'} product-live-avail">
              ${p.specifications.availability}
            </span>
          </div>
          <div class="card-floating-actions">
            <button type="button" class="quick-view-btn" data-qv-id="${p.id}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span>QUICK VIEW</span>
            </button>
          </div>
        </div>
        <div class="card-body">
          <div class="card-header-row">
            <h3 class="card-title">
              <a href="/product/${p.slug}" class="card-title-link product-live-name">${p.name}</a>
            </h3>
            <div class="card-price-wrap">
              <span class="price-val product-live-price">$${(p.salePrice || p.price).toLocaleString()}</span>
            </div>
          </div>
          <p class="card-desc product-live-desc">${p.shortDescription}</p>
          <div class="spec-pills-strip">
            <div class="spec-pill">
              <span class="spec-pill-text product-live-dim">${p.specifications.dimensions}</span>
            </div>
            <div class="spec-pill">
              <span class="spec-pill-text product-live-cap">${p.specifications.capacity}</span>
            </div>
          </div>
          <div class="card-footer-row">
            <a href="/product/${p.slug}" class="btn btn-secondary btn-sm card-view-btn">VIEW DETAILS</a>
            <button type="button" class="card-compare-btn" data-compare-id="${p.id}" title="Compare">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 3h5v5"></path>
                <path d="M4 20L21 3"></path>
                <path d="M21 16v5h-5"></path>
                <path d="M15 15l6 6"></path>
                <path d="M4 4l5 5"></path>
              </svg>
              <span>COMPARE</span>
            </button>
          </div>
        </div>
      </article>
    `).join('');
  }

  function resetAll() {
    if (searchInput) searchInput.value = '';
    const allRadio = document.querySelector('input[name="filter-category"][value="all"]') as HTMLInputElement;
    if (allRadio) allRadio.checked = true;
    document.querySelectorAll('input[type="checkbox"]').forEach((el) => {
      (el as HTMLInputElement).checked = false;
    });
    if (sortSelect) sortSelect.value = 'featured';
    applyFilters();
  }

  // Event Listeners
  searchInput?.addEventListener('input', applyFilters);
  sortSelect?.addEventListener('change', applyFilters);
  document.querySelectorAll('input[name="filter-category"]').forEach((el) => el.addEventListener('change', applyFilters));
  document.querySelectorAll('input[name="filter-price"]').forEach((el) => el.addEventListener('change', applyFilters));
  document.querySelectorAll('input[name="filter-axle"]').forEach((el) => el.addEventListener('change', applyFilters));
  document.querySelectorAll('input[name="filter-avail"]').forEach((el) => el.addEventListener('change', applyFilters));

  resetBtn?.addEventListener('click', resetAll);
  noResultsResetBtn?.addEventListener('click', resetAll);
  clearTagsAction?.addEventListener('click', resetAll);

  // Sync with state updates
  window.addEventListener('tc-demo-state-updated', applyFilters);
</script>
