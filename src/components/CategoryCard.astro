---
// CategoryCard.astro
import type { Category } from '../data/categories';

interface Props {
  category: Category;
}

const { category } = Astro.props;
---
<a href={`/trailers/${category.slug}`} class="category-card" aria-label={`Explore ${category.name}`}>
  <div class="category-img-wrap">
    <img
      src={category.heroImage}
      alt={category.name}
      loading="lazy"
      class="category-img"
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=800&q=80';"
    />
    <div class="category-overlay"></div>
  </div>

  <div class="category-content">
    <div class="category-meta-top">
      <span class="category-count-badge">{category.productCount} MODELS AVAILABLE</span>
    </div>

    <div class="category-main-text">
      <h3 class="category-name">{category.name}</h3>
      <p class="category-desc">{category.shortDescription}</p>
    </div>

    <div class="category-explore-link">
      <span>EXPLORE MODELS</span>
      <svg class="category-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</a>

<style>
  .category-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    min-height: 380px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .category-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-elevated);
  }

  .category-img-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .category-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .category-card:hover .category-img {
    transform: scale(1.06);
  }

  .category-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(37, 39, 36, 0.15) 0%,
      rgba(37, 39, 36, 0.45) 50%,
      rgba(28, 43, 36, 0.92) 100%
    );
    transition: background var(--transition-base);
  }

  .category-card:hover .category-overlay {
    background: linear-gradient(
      180deg,
      rgba(37, 39, 36, 0.2) 0%,
      rgba(37, 39, 36, 0.55) 45%,
      rgba(28, 43, 36, 0.96) 100%
    );
  }

  .category-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .category-meta-top {
    margin-bottom: auto;
  }

  .category-count-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.25rem 0.65rem;
    background-color: rgba(245, 243, 237, 0.92);
    color: var(--color-deep-charcoal);
    border-radius: var(--radius-xs);
    display: inline-block;
  }

  .category-name {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-pure-white);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .category-desc {
    font-size: 0.9rem;
    color: #E2DFD8;
    line-height: 1.5;
    margin: 0;
  }

  .category-explore-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-warm-ivory);
    margin-top: 0.5rem;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .category-arrow {
    transition: transform var(--transition-fast);
  }

  .category-card:hover .category-explore-link {
    color: var(--color-muted-copper);
  }

  .category-card:hover .category-arrow {
    transform: translateX(4px);
  }
</style>
