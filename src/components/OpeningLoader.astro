---
// OpeningLoader.astro
---
<div id="opening-loader" class="opening-loader" aria-hidden="true">
  <div class="loader-content">
    <div class="loader-brand">
      <div class="loader-emblem">
        <svg viewBox="0 0 48 48" fill="none" class="emblem-svg">
          <rect width="48" height="48" rx="8" fill="#26372F"/>
          <path d="M12 28L18 16H36L30 28H12Z" fill="#F5F3ED"/>
          <circle cx="19" cy="33" r="3.5" fill="#A66E4D"/>
          <circle cx="29" cy="33" r="3.5" fill="#A66E4D"/>
        </svg>
      </div>
      <span class="loader-title">TRAILER COMMERCE</span>
    </div>
    <p class="loader-sub">BUILT FOR THE JOURNEY</p>
    <div class="loader-bar-wrap">
      <div class="loader-bar-fill"></div>
    </div>
  </div>
</div>

<style>
  .opening-loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-warm-ivory);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.5s ease;
    pointer-events: all;
  }

  .opening-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem;
  }

  .loader-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .loader-emblem {
    width: 38px;
    height: 38px;
  }

  .emblem-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .loader-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-deep-charcoal);
  }

  .loader-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--color-muted-copper);
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .loader-bar-wrap {
    width: 180px;
    height: 2px;
    background-color: rgba(37, 39, 36, 0.12);
    border-radius: 99px;
    overflow: hidden;
    position: relative;
  }

  .loader-bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background-color: var(--color-forest-green);
    animation: loaderProgress 1.1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes loaderProgress {
    0% { width: 0%; }
    50% { width: 65%; }
    100% { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening-loader {
      display: none !important;
    }
  }
</style>

<script>
  (function() {
    const loader = document.getElementById('opening-loader');
    if (!loader) return;

    // Check if shown in this browser session
    const hasShown = sessionStorage.getItem('tc_opening_loader_shown');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hasShown || prefersReducedMotion) {
      loader.classList.add('is-hidden');
      loader.remove();
    } else {
      sessionStorage.setItem('tc_opening_loader_shown', 'true');
      setTimeout(() => {
        loader.classList.add('is-hidden');
        setTimeout(() => {
          if (loader.parentNode) loader.parentNode.removeChild(loader);
        }, 550);
      }, 1200);
    }
  })();
</script>
