---
// src/layouts/AdminLayout.astro
import '../styles/variables.css';
import '../styles/global.css';

interface Props {
  title: string;
  activeNav: 'dashboard' | 'products' | 'categories' | 'posts' | 'media' | 'pages' | 'settings';
}

const { title, activeNav } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Payload CMS Admin | TRAILER COMMERCE</title>
    <!-- Prevent indexing of administrative paths -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="admin-body">
    <div class="admin-wrapper">
      <!-- Admin Sidebar -->
      <aside class="admin-sidebar" aria-label="CMS Navigation">
        <div class="admin-sidebar-header">
          <a href="/admin" class="admin-brand">
            <div class="admin-logo-mark">
              <svg viewBox="0 0 48 48" fill="none" class="admin-logo-svg">
                <rect width="48" height="48" rx="8" fill="#26372F"/>
                <path d="M12 28L18 16H36L30 28H12Z" fill="#F5F3ED"/>
                <circle cx="19" cy="33" r="3.5" fill="#A66E4D"/>
                <circle cx="29" cy="33" r="3.5" fill="#A66E4D"/>
              </svg>
            </div>
            <div class="admin-brand-text">
              <span class="admin-brand-name">TRAILER COMMERCE</span>
              <span class="admin-cms-badge">PAYLOAD CMS ARCHITECTURE</span>
            </div>
          </a>
        </div>

        <!-- Collections & Nav -->
        <nav class="admin-nav" aria-label="Collections and configuration">
          <div class="nav-section">
            <span class="nav-section-title">OVERVIEW</span>
            <ul class="admin-nav-list">
              <li>
                <a href="/admin" class:list={['admin-nav-item', { 'is-active': activeNav === 'dashboard' }]}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                  </svg>
                  <span>Dashboard</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="nav-section">
            <span class="nav-section-title">COMMERCE & INVENTORY</span>
            <ul class="admin-nav-list">
              <li>
                <a href="/admin/products" class:list={['admin-nav-item', { 'is-active': activeNav === 'products' }]}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                  <span>Products</span>
                </a>
              </li>
              <li>
                <a href="/admin/categories" class:list={['admin-nav-item', { 'is-active': activeNav === 'categories' }]}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <span>Categories</span>
                </a>
              </li>
              <li>
                <a href="/admin/media" class:list={['admin-nav-item', { 'is-active': activeNav === 'media' }]}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                  <span>Media Library</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="nav-section">
            <span class="nav-section-title">CONTENT & EDITORIAL</span>
            <ul class="admin-nav-list">
              <li>
                <a href="/admin/posts" class:list={['admin-nav-item', { 'is-active': activeNav === 'posts' }]}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                  <span>Blog Posts</span>
                </a>
              </li>
              <li>
                <a href="/admin/pages" class:list={['admin-nav-item', { 'is-active': activeNav === 'pages' }]}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                  </svg>
                  <span>Pages & Copy</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="nav-section">
            <span class="nav-section-title">PREFERENCES</span>
            <ul class="admin-nav-list">
              <li>
                <a href="/admin/settings" class:list={['admin-nav-item', { 'is-active': activeNav === 'settings' }]}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                  </svg>
                  <span>Site Settings</span>
                </a>
              </li>
            </ul>
          </div>
        </nav>

        <!-- Sidebar Bottom Footer -->
        <div class="admin-sidebar-footer">
          <div class="user-profile-badge">
            <div class="user-avatar-initials">AD</div>
            <div class="user-meta-info">
              <span class="user-display-name">Serkan (Admin)</span>
              <span class="user-role-label">Full Permissions</span>
            </div>
          </div>

          <div class="sidebar-secondary-links">
            <a href="/" target="_blank" class="sidebar-sec-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>View Storefront</span>
            </a>
            <a href="/handover" class="sidebar-sec-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              <span>Handover Guide</span>
            </a>
            <button id="admin-logout-btn" class="sidebar-sec-link logout-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Sign Out</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- Admin Main Area -->
      <div class="admin-main-stage">
        <!-- Top Control Bar -->
        <header class="admin-topbar">
          <div class="topbar-left">
            <h1 class="topbar-page-title">{title}</h1>
            <span class="sync-status-badge">
              <span class="status-live-dot"></span>
              Live Storefront Sync
            </span>
          </div>

          <div class="topbar-right">
            <a href="/" target="_blank" class="btn btn-outline-white btn-sm topbar-preview-btn">
              <span>View Live Storefront</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
            <button id="reset-demo-state-btn" class="btn-topbar-reset" title="Reset all inventory edits to default">
              Reset Demo
            </button>
          </div>
        </header>

        <!-- Main Panel Body -->
        <main class="admin-content-canvas">
          <slot />
        </main>
      </div>
    </div>

    <!-- Simulated Auth Verification Script -->
    <script>
      import { loadDemoState, resetDemoState } from '../utils/demo-state';

      function verifyAdminAccess() {
        const state = loadDemoState();
        // Check if user is authenticated or logged in
        const isAuth = state.auth && state.auth.isAuthenticated;
        if (!isAuth && !window.location.pathname.includes('/admin/login')) {
          // If not authenticated, redirect to login page
          window.location.href = `/admin/login?redirect=${encodeURIComponent(window.location.pathname)}`;
        }
      }

      document.getElementById('admin-logout-btn')?.addEventListener('click', () => {
        const state = loadDemoState();
        state.auth = { isAuthenticated: false, user: null };
        localStorage.setItem('trailer_commerce_demo_state_v2', JSON.stringify(state));
        window.location.href = '/admin/login';
      });

      document.getElementById('reset-demo-state-btn')?.addEventListener('click', () => {
        if (confirm('Reset all demo inventory and text edits back to factory defaults?')) {
          resetDemoState();
          window.location.reload();
        }
      });

      // Run verification
      verifyAdminAccess();
    </script>
  </body>
</html>

<style>
  /* Layout Architecture */
  .admin-body {
    background-color: #F7F6F2;
    color: var(--color-deep-charcoal);
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }

  .admin-wrapper {
    display: flex;
    min-height: 100vh;
  }

  /* Admin Sidebar */
  .admin-sidebar {
    width: 270px;
    background-color: #FFFFFF;
    border-right: 1px solid var(--border-medium);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    z-index: 50;
  }

  .admin-sidebar-header {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid var(--border-light);
  }

  .admin-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .admin-logo-mark {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }

  .admin-logo-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .admin-brand-text {
    display: flex;
    flex-direction: column;
  }

  .admin-brand-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--color-deep-charcoal);
  }

  .admin-cms-badge {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    color: var(--color-forest-green);
    letter-spacing: 0.08em;
  }

  /* Nav */
  .admin-nav {
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex: 1;
  }

  .nav-section-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    display: block;
    padding-left: 0.65rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .admin-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .admin-nav-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .admin-nav-item:hover {
    background-color: var(--color-pale-sand);
    color: var(--color-deep-charcoal);
  }

  .admin-nav-item.is-active {
    background-color: var(--color-forest-green);
    color: var(--color-pure-white);
  }

  .admin-nav-item.is-active svg {
    stroke: var(--color-pure-white);
  }

  /* Footer */
  .admin-sidebar-footer {
    padding: 1.25rem;
    border-top: 1px solid var(--border-light);
    background-color: #FAFAF7;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .user-profile-badge {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .user-avatar-initials {
    width: 32px;
    height: 32px;
    background-color: var(--color-forest-green);
    color: var(--color-pure-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .user-meta-info {
    display: flex;
    flex-direction: column;
  }

  .user-display-name {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-deep-charcoal);
  }

  .user-role-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .sidebar-secondary-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sidebar-sec-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.35rem 0;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: color var(--transition-fast);
  }

  .sidebar-sec-link:hover {
    color: var(--color-forest-green);
  }

  .logout-btn:hover {
    color: #A82424;
  }

  /* Main Stage */
  .admin-main-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Topbar */
  .admin-topbar {
    height: 65px;
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--border-medium);
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .topbar-page-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
  }

  .sync-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    background-color: #E8F2EC;
    color: #1F6B42;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .status-live-dot {
    width: 6px;
    height: 6px;
    background-color: #1F6B42;
    border-radius: 50%;
    animation: livePulse 2s infinite;
  }

  @keyframes livePulse {
    0% { opacity: 1; }
    50% { opacity: 0.3; }
    100% { opacity: 1; }
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .topbar-preview-btn {
    border-color: var(--border-medium);
    color: var(--color-deep-charcoal);
  }

  .topbar-preview-btn:hover {
    background-color: var(--color-forest-green);
    color: var(--color-pure-white);
  }

  .btn-topbar-reset {
    background: transparent;
    border: 1px dashed var(--border-medium);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .btn-topbar-reset:hover {
    color: #A82424;
    border-color: #A82424;
  }

  /* Content Canvas */
  .admin-content-canvas {
    padding: 2rem;
    flex: 1;
    overflow-y: auto;
  }

  @media (max-width: 900px) {
    .admin-wrapper {
      flex-direction: column;
    }
    .admin-sidebar {
      width: 100%;
      height: auto;
      position: static;
    }
    .admin-content-canvas {
      padding: 1.25rem;
    }
  }
</style>
